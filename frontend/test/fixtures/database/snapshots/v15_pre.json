    "prevent_second_open_shift_update": "CREATE TRIGGER prevent_second_open_shift_update BEFORE UPDATE OF status ON shifts WHEN NEW.status = 'OPEN' AND EXISTS (SELECT 1 FROM shifts WHERE status = 'OPEN' AND id != NEW.id) BEGIN SELECT RAISE(ABORT, 'A shift is already open'); END"
