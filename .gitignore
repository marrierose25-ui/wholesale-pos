# Python
__pycache__/
*.py[cod]
.pytest_cache/
.env
venv/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
.vs/

# Local AI/agent tooling state (never shared, often contains screenshots,
# browser caches and machine-specific paths). The permanent governance rules
# under .claude/rules/ ARE versioned — everything else stays local.
.claude/*
!.claude/rules/
.claude/rules/*
!.claude/rules/*.md
.devin/
.playwright-mcp/

# Flutter (THIS PREVENTS THE 134MB BLOAT)
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Databases
*.db
*.sqlite
# Exception: the eight synthetic historical migration fixtures are required by
# frontend/test/core/database/historical_fixture_migration_test.dart. They are
# generated by tool/database_fixtures/build_historical_fixtures.py and contain
# only fixture data — never real business or user data.
!frontend/test/fixtures/database/*/wholesale_pos.db

# Local licensing artifacts and private signing material
frontend/license.key
frontend/**/license.key
*.private-key
*.signing-key
*.ed25519

# Supabase CLI local state (can contain access tokens) — never commit.
backend/supabase/.temp/
backend/supabase/supabase/.temp/

# Vercel CLI temp working dir created by the web deploy script.
frontend/.vercel-tmp/

# Wrangler (Cloudflare Pages) local deploy cache — never commit.
.wrangler/
frontend/.wrangler/

# Ad-hoc browser walkthrough screenshots (local verification artifacts).
walkthrough_shots/
/shots/
/*.png
frontend/dashboard_screenshot.png

# Agent-session leftovers: patch dumps and one-off fix scripts.
/batch_*.txt
/fix.ps1

# IDE agent workspace state (its own screenshots, caches).
.qoder/

_audit/
audit.sh
batch_*.txt
WholesalePOS_Windows_Release.zip
frontend/.dart_tool/
.dart_tool/

# Generated Dart build output inside backend packages (native assets, test
# caches) — never commit; regenerate with `dart test` / `flutter build`.
backend/**/build/

# Graphify knowledge-graph output — regenerable via `graphify update .`.
graphify-out/
backend/supabase/schemas/
